# AutoForge local environment template.
# Copy this file to .env before running optional real LLM agent experiments.
# The default deterministic verification path does not require an API key.

LLM_PROVIDER=deepseek
LLM_MODEL_NAME=deepseek-v4-pro

# Fill in only when running strategy=agent or forge CLI.
DEEPSEEK_API_KEY=

# Optional alternative providers:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_PROVIDER=qwen
# DASHSCOPE_API_KEY=
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Safe local defaults for verification.
SANDBOX_BACKEND=local
AUTOFORGE_ENABLE_VECTOR_STORE=0
AUTOFORGE_SIMILARITY_THRESHOLD=0.75
AUTOFORGE_ENABLE_LLM_MATCH_VERIFY=0
AUTOFORGE_ENABLE_AGENT_SLOW_PATH=0
AUTOFORGE_FORGE_LOG_DIR=./data/forge_logs
AUTOFORGE_SKILLS_DIR=skills
