{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://autoforge.local/evaluation/benchmark/dataset_schema.json",
	"title": "AutoForge Benchmark Dataset",
	"type": "array",
	"minItems": 1,
	"items": {
		"type": "object",
		"required": [
			"sample_id",
			"difficulty",
			"query",
			"paraphrases",
			"expected_output",
			"expected_output_type",
			"tool_family"
		],
		"additionalProperties": false,
		"properties": {
			"sample_id": {
				"type": "string",
				"pattern": "^L[1-4]_[0-9]{3}$"
			},
			"difficulty": {
				"type": "integer",
				"minimum": 1,
				"maximum": 4
			},
			"query": {
				"type": "string",
				"minLength": 3
			},
			"paraphrases": {
				"type": "array",
				"minItems": 3,
				"maxItems": 5,
				"items": {
					"type": "string",
					"minLength": 3
				}
			},
			"expected_output": {},
			"expected_output_type": {
				"type": "string",
				"enum": [
					"exact",
					"numeric",
					"contains"
				]
			},
			"tool_family": {
				"type": "string",
				"minLength": 2
			},
			"notes": {
				"type": "string"
			}
		}
	}
}
